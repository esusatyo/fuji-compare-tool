{
  "name": "fuji-compare-tool",
  "version": "1.0.0",
  "description": "Multi-brand camera & lens comparison tool",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "scripts": {
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/data/*.test.js tests/logic/*.test.js tests/worker/*.test.js",
    "test:data": "node --test tests/data/*.test.js",
    "test:logic": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/logic/*.test.js",
    "test:worker": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/worker/*.test.js",
    "test:links": "RUN_LINK_TESTS=1 node --test --test-concurrency=1 tests/links/*.test.js",
    "test:all": "npm test && npm run test:links",
    "deploy": "wrangler deploy",
    "preview": "wrangler dev"
  },
  "devDependencies": {
    "jsdom": "^24.1.0",
    "wrangler": "^4.110.0"
  }
}
